# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
dist-*/
build/
*.egg-info/
*.egg

# MkDocs build output
site/

# Virtual environments
venv/
.venv/
.venv-*/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Consciousness state data (user-specific)
.consciousness/
# MemPalace diary archives — local only
mempalace/
# Hermes plans — session-specific
.hermes/

# SQLite database artifacts
*.db
*.db-wal
*.db-shm
*.db-journal

# Ruff cache
.ruff_cache/

# MyPy cache
.mypy_cache/

# Graphify output — generated MIT input (graph.json etc.), not source; the
# v1.7 distiller reads it as data. Regenerate with `graphify .`.
graphify-out/

# internal design docs (specs/plans/brainstorms) — never committed.
# Five brainstorms predated this rule and were untracked in v4.0; a .gitignore
# entry does not cover a file git already tracks.
docs/superpowers/

# Internal working notes: audits, field reports, model studies, generated
# reference dumps. They stay on disk and out of the repo and the docs site
# (mkdocs `exclude_docs` keeps a local build from picking them up).
AUDIT_FINDINGS.md
docs/AUDIT-*.md
docs/REPORT_*.md
docs/Report-*.md
docs/Knolayer.md
docs/blueprint*.md
docs/f3-*.md
docs/fable*.md
docs/*-prompt*.md
docs/patterns/
docs/reference/conscio_functions.md
docs/verdent-*

# Claude Code harness reference — internal research, local only
docs/reference/claude-code-harness.md

# Local Claude Code state: the governor writes the context ceiling (and a dated
# backup) into settings.local.json, which is per-machine by definition.
.claude/settings.local.json*
.claude/worktrees/

# Local Netlify folder
.netlify
